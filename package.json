{
  "name": "tamper-proof-project-log",
  "version": "2.0.0",
  "private": true,
  "description": "Tamper-Proof Project Submission & Evaluation Log (Ethereum + IPFS)",
  "scripts": {
    "setup": "npm install && npm install --prefix frontend",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "chain": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "seed": "hardhat run scripts/seed.js --network localhost",
    "server": "node server/index.js",
    "frontend": "npm run dev --prefix frontend",
       "dev": "concurrently --kill-others-on-fail -n chain,deploy,server,web -c blue,yellow,green,magenta \"npm run chain\" \"wait-on tcp:127.0.0.1:8545 && npm run deploy:local && npm run seed\" \"npm run server\" \"npm run frontend\""
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "concurrently": "^9.0.1",
    "hardhat": "^2.22.10",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.4",
    "express": "^4.21.1",
    "form-data": "^4.0.1",
    "multer": "^1.4.5-lts.1"
  }
}
